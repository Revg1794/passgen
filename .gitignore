__pycache__/
*.py[cod]

# Your real banned-term lists stay local. banned-example.txt is the template
# that ships; anything named *.local.txt is yours and is never committed.
*.local.txt
banned-local.txt

# Never commit generated passwords.
passwords.txt
*.passwords

# Build artefacts. Released binaries live on GitHub Releases, not in the repo.
build/
dist/
*.spec
*.exe
*.egg-info/

# Your own config stays local; passgen.conf.example is the template.
passgen.conf
